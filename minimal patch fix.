+private fun formatBytes(bytes: Long): String {
+    if (bytes <= 0L) return "--"
+    val mb = bytes / (1024.0 * 1024.0)
+    return if (mb >= 1024) {
+        String.format(Locale.US, "%.2f GB", mb / 1024.0)
+    } else {
+        String.format(Locale.US, "%.0f MB", mb)
+    }
+}
